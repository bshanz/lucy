# Copy to .env.local and fill in. NEVER commit .env.local (gitignored).

# --- Model routing ---
# Vercel AI Gateway key, or run `vercel link && vercel env pull` to use VERCEL_OIDC_TOKEN
AI_GATEWAY_API_KEY=

# --- Agent identity (optional) ---
# AGENT_NAME=Lucy

# --- Owner identity ---
OWNER_NAME=Jane Doe
# Your phone in E.164 — the ONLY sender the iMessage channel trusts
OWNER_PHONE=+1XXXXXXXXXX
# Your HOME IANA timezone. Reminder/calendar times are interpreted in this zone
# unless travel mode is on: the set_timezone tool can override it temporarily
# (stored in channel_state, expires on a return date), and this is what it
# reverts to. Change this only if you actually move.
OWNER_TIMEZONE=America/New_York
# Your Slack member ID (profile → three dots → Copy member ID); only this user can DM the agent
OWNER_SLACK_USER_ID=
# The Google account the agent reads mail/calendar/tasks from
OWNER_EMAIL=you@example.com

# --- Sendblue (iMessage) ---
# From `sendblue show-keys` after `sendblue setup` (free sandbox works)
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
# Your Sendblue line, from `sendblue lines`
SENDBLUE_FROM_NUMBER=

# --- Supabase ---
# Create a project, run the migrations in supabase/migrations, then:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Project Settings → API keys → secret key (sb_secret_...)
SUPABASE_SECRET_KEY=

# --- Route protection ---
# Bearer secret for the webhook + gmail authorize routes. Generate: openssl rand -hex 32
LUCY_AGENT_SECRET=

# --- Google via Vercel Connect ---
# Connector UID from the Vercel Connect dashboard (UID, NOT the display name)
GMAIL_CONNECTOR_UID=
# Subject id the Google grant is stored under (default "owner"; keep stable forever)
# GMAIL_CONNECT_SUBJECT=owner

# --- SerpAPI (Google Flights) ---
# serpapi.com → Dashboard → Your Private API Key. Free tier = 250 searches/month.
# Powers flight price lookups and tracking. The daily poller spends one search per
# active watch (max 6), leaving ~64/month for ad-hoc questions. Cached repeats within
# an hour are free; a daily poll is 24h apart and never hits that cache.
SERPAPI_API_KEY=
# Owner-local hour the flight poller does its work. Only for testing the schedule
# outside 9am — leave unset in production.
# FLIGHT_POLL_HOUR=9

# --- Resy (restaurant reservations) ---
# NOTHING TO SET HERE FOR A NORMAL SETUP. Resy signs in with a texted code, so you
# link the account by conversation instead of by config: say "connect resy" to Lucy,
# she asks Resy to text OWNER_PHONE a 6-digit code, you text it back, and she stores
# a 45-day token + 90-day refresh token in Supabase. A daily cron renews them and
# each renewal rolls the refresh window forward, so it effectively never expires.
# Until you do that, every Resy tool cleanly reports "not connected".
#
# Optional: only if your account also HAS a password. Lucy prefers the stored tokens
# and touches these solely when refresh fails — it's the difference between a session
# that self-heals and one that needs you to text a code. Safe to leave blank.
# RESY_EMAIL=
# RESY_PASSWORD=
#
# Optional escape hatch. The public web API key is scraped from resy.com's JS bundle
# at runtime because it ROTATES — the key hardcoded in every Resy bot on GitHub is
# already dead. Set this only if the scrape starts failing; a stale key still beats
# no key. Do NOT copy one from a GitHub repo, read it out of your own browser's
# network tab (Authorization: ResyAPI api_key="...").
# RESY_API_KEY_FALLBACK=
#
# Set to 1 to skip the approval card on book_resy and snipe_resy. The bounds are
# still enforced in code either way — seating window, deposit cap, venue guard,
# snipe cap, and the anti-double-booking claim all survive this. What you give up
# is reading those bounds back before they take effect. Deliberately NOT applied
# to cancel_resy_booking: giving a table back is destructive and never urgent.
# RESY_AUTO_APPROVE=1

# Optional. Sent alongside the login code exchange. The default matches Resy's web
# client; override only if code verification starts rejecting valid codes.
# RESY_DEVICE_TYPE_ID=3
# RESY_DEVICE_TOKEN=lucy-agent

# --- Nightly healthy-eating check-in (optional) ---
# Set to 1 to teach the agent how to read the answer to a recurring yes/no
# check-in: Like means yes, Dislike means no, and the answer is logged as a
# moment with a fixed body. The reminder itself is created by conversation and
# lives in Supabase; this flag only turns on the prompt half. Leave unset unless
# you actually run that routine.
# HEALTH_CHECKIN=1
